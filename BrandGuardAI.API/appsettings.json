{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=BrandGuardDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "SqliteConnection": "Data Source=BrandGuardAI.db"
  },
  "Database": {
    "Provider": "Auto"
  },
  "AI": {
    "Provider": "OpenRouter",
    "ChatEndpoint": "https://openrouter.ai/api/v1/chat/completions",
    "ChatModel": "google/gemini-2.5-flash",
    "EmbeddingEndpoint": "https://openrouter.ai/api/v1/embeddings",
    "EmbeddingModel": "text-embedding-3-small"
  }
}
